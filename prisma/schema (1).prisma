datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  archetype String   @default("trust-led")
  createdAt DateTime @default(now())

  users  User[]
  site   Site?
  events Event[]
  posts  Post[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("client")
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// model: String (JSON) — SQLite nie obsluguje Json; na Postgres zmien na Json.
model Site {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model     String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime
  description String
  link        String?
  status      String   @default("published")
  createdAt   DateTime @default(now())

  @@index([tenantId, status])
}

model Post {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  body        String
  publishedAt DateTime?
  status      String    @default("draft")
  createdAt   DateTime  @default(now())

  @@index([tenantId, status])
}

// before/after: String (JSON) — SQLite nie obsluguje Json; na Postgres zmien na Json?.
model EditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  target    String
  before    String?
  after     String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}
